# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string (Atlas -> your cluster -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jobdashboard?retryWrites=true&w=majority

# Apify API token (Apify Console -> Settings -> API & Integrations). Apify runs LinkedIn and Indeed.
APIFY_TOKEN=

# Most jobs one search may return on LinkedIn ($0.40 per 1,000) and on Indeed ($0.10 per 1,000). These are
# the Apify cost controls; each run prints what it will cost before it starts.
APIFY_LIMIT_PER_SEARCH=100
INDEED_LIMIT_PER_SEARCH=100

# --- Naukri and Glassdoor: our Python scraper in naukri-scraper/ (free, opens real Chrome windows) ---
# Most jobs one search may return (a course can read more: searchLimits in server/src/config/courses.js).
NAUKRI_LIMIT_PER_SEARCH=200
GLASSDOOR_LIMIT_PER_SEARCH=100
# Leave empty to use naukri-scraper/.venv. Set only if the scraper or its Python live elsewhere.
NAUKRI_SCRAPER_DIR=
NAUKRI_SCRAPER_PYTHON=
# 1 = hide the browser windows. Naukri currently blocks hidden browsers (HTTP 403), so keep 0.
SCRAPER_HEADLESS=0
# Stop a platform's scraper if its run takes longer than this. More searches get more time (Naukri and
# Glassdoor 1 minute a search, more when a search reads more). Unfinished searches are retried once.
SCRAPER_TIMEOUT_MINUTES=30

# How many Apify runs to start at the same time
APIFY_CONCURRENCY=3

# Only jobs whose minimum experience is within this range (years) are kept.
# The excluded companies are listed in server/src/config/filters.js.
# After changing either, run `npm run reclassify` to apply it to stored jobs.
EXPERIENCE_MIN=2
EXPERIENCE_MAX=5

# Platforms to skip, comma-separated (LinkedIn, Naukri, Indeed, Glassdoor)
DISABLED_SOURCES=

# Same company + title + city seen again within this many days = the same job (a repost or
# the same job on another platform). After that, it counts as a new opening.
DEDUPE_WINDOW_DAYS=14

# Delete jobs that no source has shown for this many days
RETENTION_DAYS=90

# Optional: password for the dashboard (any username works). Leave empty for no login.
# Works only when this server also serves the dashboard (the usual setup).
DASHBOARD_PASSWORD=

# Only if the dashboard (scraper-frontend) is hosted on its own address, e.g. Vercel: that address,
# so browsers let it use this API. Comma-separated for several. Leave empty in the usual setup.
# Example: CORS_ORIGINS=https://ijf-jobs.vercel.app
CORS_ORIGINS=

# Sign-in (Clerk), required for saving changes from the dashboard: the same Clerk application as the
# dashboard's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (Clerk dashboard -> API keys -> Secret keys). This server
# checks each change's sign-in with it, accepts it only from an allowed role, and records it under the
# person's email (the activity record). Without it, changes are refused. Keep it secret.
CLERK_SECRET_KEY=
# Optional: only accept sign-ins made on these dashboard addresses (comma-separated).
# Example: CLERK_AUTHORIZED_PARTIES=https://ijf-jobs.vercel.app,http://localhost:3001
CLERK_AUTHORIZED_PARTIES=

# IJF AI (the chat): an OpenAI key, on the backend only (Render), never on the frontend (Vercel). Empty: the
# chat is switched off and its button isn't shown. Phone numbers and emails are never sent to OpenAI.
OPEN_AI_API_KEY=
# Optional: the model (any OpenAI chat model with tool calling), its reasoning effort ('' = the model's
# default), and questions per person per day (people aren't told the number).
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# AI_DAILY_LIMIT=50

# Shown in the dashboard header
SCHEDULE_LABEL=Updated daily at 07:00 IST

PORT=3000
